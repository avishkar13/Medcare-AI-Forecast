# Where the Express API lives. The engine has no database credentials by design:
# it reads history from GET {API_BASE_URL}/training-data and nothing else.
API_BASE_URL=http://localhost:4000/api

# Deployed backend:
# API_BASE_URL=http://ec2-3-111-32-88.ap-south-1.compute.amazonaws.com:4000/api

ENGINE_PORT=8000
ENGINE_MAX_HORIZON_DAYS=180
ENGINE_MIN_HISTORY_DAYS=35

# /api/training-data is rate limited to 10 requests per hour, so a pull is reused
# for this long instead of being repeated per forecast request.
TRAINING_CACHE_TTL_SECONDS=900
TRAINING_TIMEOUT_SECONDS=120

MODEL_VERSION=medcare-xgb-qrf-v1
