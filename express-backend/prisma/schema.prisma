generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model Product {
  id                 String              @id @default(cuid())
  sku                String              @unique
  name               String
  category           String?
  unit               String              @default("unit")
  unitCost           Decimal             @db.Decimal(12, 2)
  shelfLifeDays      Int?
  isActive           Boolean               @default(true)
}
enum Criticality {
  LOW
  MEDIUM
  HIGH
}