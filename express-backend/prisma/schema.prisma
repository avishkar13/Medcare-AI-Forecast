generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  scenarios            Scenario[]
  planningRuns         PlanningRun[]
  actedRecommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
}

model Product {
  id            String      @id @default(cuid())
  sku           String      @unique
  name          String
  category      String?
  unit          String      @default("unit")
  unitCost      Decimal     @db.Decimal(12, 2)
  shelfLifeDays Int?
  criticality   Criticality @default(MEDIUM)
  isActive      Boolean     @default(true)

  demandHistory      DemandHistory[]
  inventory          Inventory[]
  batches            InventoryBatch[]
  planningParameters PlanningParameter[]
  forecasts          Forecast[]
  inventoryPlans     InventoryPlan[]
  supplyPlans        SupplyPlan[]
  drpPlans           DRPPlan[]
  recommendations    Recommendation[]
  promotionEvents    PromotionEvent[]
  demandSignals      DemandSignal[]
  distributorOrders  DistributorOrder[]
  alerts             Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([criticality])
}

model Warehouse {
  id       String        @id @default(cuid())
  code     String        @unique
  name     String
  region   String?
  tier     WarehouseTier
  location String?
  capacity Int?
  isActive Boolean       @default(true)

  demandHistory      DemandHistory[]
  inventory          Inventory[]
  batches            InventoryBatch[]
  planningParameters PlanningParameter[]
  forecasts          Forecast[]
  inventoryPlans     InventoryPlan[]
  supplyPlans        SupplyPlan[]
  drpFrom            DRPPlan[]           @relation("DRPFrom")
  drpTo              DRPPlan[]           @relation("DRPTo")
  recommendations    Recommendation[]
  promotionEvents    PromotionEvent[]
  distributors       Distributor[]
  distributorOrders  DistributorOrder[]
  alerts             Alert[]
  stockMovements     StockMovement[]
  wastePrevention    WastePreventionRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@index([tier])
}

model DemandHistory {
  id                String   @id @default(cuid())
  productId         String
  warehouseId       String
  date              DateTime
  orderedQuantity   Float
  fulfilledQuantity Float?
  stockoutFlag      Boolean  @default(false)
  promotionFlag     Boolean  @default(false)
  holidayFlag       Boolean  @default(false)
  season            String?

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  @@unique([productId, warehouseId, date])
  @@index([productId, warehouseId, date])
  @@index([date])
}

model Inventory {
  id          String @id @default(cuid())
  productId   String
  warehouseId String
  onHand      Float  @default(0)
  reserved    Float  @default(0)
  inTransit   Float  @default(0)

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model InventoryBatch {
  id                String    @id @default(cuid())
  productId         String
  warehouseId       String
  batchNumber       String
  quantity          Float
  manufacturingDate DateTime?
  expiryDate        DateTime

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, warehouseId, expiryDate])
  @@index([expiryDate])
}

model PlanningParameter {
  id                  String @id @default(cuid())
  productId           String
  warehouseId         String
  leadTimeDays        Int
  leadTimeStdDev      Float  @default(0)
  serviceLevel        Float  @default(0.95)
  reviewPeriodDays    Int    @default(7)
  minimumOrderQty     Float  @default(0)
  maximumInventory    Float?
  holdingCostPerUnit  Float
  stockoutCostPerUnit Float
  expiryCostPerUnit   Float

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
}

model PromotionEvent {
  id           String        @id @default(cuid())
  productId    String?
  warehouseId  String?
  name         String
  type         PromotionType @default(PROMOTION)
  startDate    DateTime
  endDate      DateTime
  upliftFactor Float         @default(1)

  product   Product?   @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  @@index([startDate, endDate])
  @@index([productId, startDate])
}

model DemandSignal {
  id         String   @id @default(cuid())
  productId  String?
  region     String?
  date       DateTime
  signalType String
  value      Float

  product Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([signalType, date])
  @@index([productId, date])
}

model Distributor {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  region      String?
  warehouseId String?
  isActive    Boolean @default(true)

  warehouse Warehouse?         @relation(fields: [warehouseId], references: [id])
  orders    DistributorOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DistributorOrder {
  id                String   @id @default(cuid())
  distributorId     String
  productId         String
  warehouseId       String
  orderDate         DateTime
  requestedDate     DateTime
  quantity          Float
  fulfilledQuantity Float?

  distributor Distributor @relation(fields: [distributorId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, warehouseId, orderDate])
  @@index([distributorId, orderDate])
}

model Scenario {
  id                 String  @id @default(cuid())
  name               String
  description        String?
  demandMultiplier   Float   @default(1)
  leadTimeMultiplier Float   @default(1)
  capacityMultiplier Float   @default(1)
  serviceLevelTarget Float   @default(0.95)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  planningRuns PlanningRun[]

  metrics    SimulationMetric[]
  dcImpacts  ScenarioDCImpact[]
  skuImpacts ScenarioSKUImpact[]
  risks      ScenarioRiskIndicator[]
  riskLevel  String?

  createdAt DateTime @default(now())
}

model PlanningRun {
  id           String    @id @default(cuid())
  scenarioId   String?
  createdById  String
  status       RunStatus @default(PENDING)
  horizonDays  Int
  modelVersion String?
  startedAt    DateTime?
  completedAt  DateTime?

  failureReason String?
  failureStage  String?

  // Progress reporting for a client polling a run that takes tens of seconds.
  // `currentStage` uses the same vocabulary as `failureStage`, so a FAILED run's
  // two fields agree instead of describing the same moment differently.
  currentStage String?
  progress     Int?

  scenario  Scenario? @relation(fields: [scenarioId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  forecasts       Forecast[]
  inventoryPlans  InventoryPlan[]
  supplyPlans     SupplyPlan[]
  drpPlans        DRPPlan[]
  optimization    OptimizationResult?
  simulation      SimulationRun?
  recommendations Recommendation[]

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status, completedAt])
}

model Forecast {
  id            String   @id @default(cuid())
  planningRunId String
  productId     String
  warehouseId   String
  forecastDate  DateTime
  p10           Float
  p50           Float
  p90           Float
  modelVersion  String

  planningRun PlanningRun @relation(fields: [planningRunId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  @@unique([planningRunId, productId, warehouseId, forecastDate])
}

model InventoryPlan {
  id                 String   @id @default(cuid())
  planningRunId      String
  productId          String
  warehouseId        String
  date               DateTime
  forecastDemand     Float
  safetyStock        Float
  reorderPoint       Float
  openingInventory   Float
  projectedInventory Float
  netRequirement     Float
  daysOfSupply       Float?
  stockoutRisk       Float?
  expiryRisk         Float?

  planningRun PlanningRun @relation(fields: [planningRunId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])

  @@unique([planningRunId, productId, warehouseId, date])
}

model SupplyPlan {
  id            String       @id @default(cuid())
  planningRunId String
  productId     String
  warehouseId   String
  date          DateTime
  quantity      Float
  source        SupplySource
  status        PlanStatus   @default(PROPOSED)

  planningRun PlanningRun @relation(fields: [planningRunId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])

  @@index([planningRunId, productId, warehouseId])
}

model DRPPlan {
  id              String   @id @default(cuid())
  planningRunId   String
  productId       String
  fromWarehouseId String
  toWarehouseId   String
  date            DateTime
  quantity        Float
  reason          String?

  planningRun   PlanningRun @relation(fields: [planningRunId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
  fromWarehouse Warehouse   @relation("DRPFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse   @relation("DRPTo", fields: [toWarehouseId], references: [id])

  @@index([planningRunId, productId])
}

model OptimizationResult {
  id             String @id @default(cuid())
  planningRunId  String @unique
  objectiveValue Float
  holdingCost    Float
  stockoutCost   Float
  transferCost   Float
  expiryCost     Float
  totalCost      Float
  baselineCost   Float?
  solver         String
  solverStatus   String

  planningRun PlanningRun @relation(fields: [planningRunId], references: [id])

  createdAt DateTime @default(now())
}

model SimulationRun {
  id                  String @id @default(cuid())
  planningRunId       String @unique
  iterations          Int
  serviceLevel        Float
  stockoutProbability Float
  expiryProbability   Float
  expectedInventory   Float
  expectedWaste       Float
  expectedCost        Float

  planningRun PlanningRun @relation(fields: [planningRunId], references: [id])

  createdAt DateTime @default(now())
}

model Recommendation {
  id            String               @id @default(cuid())
  planningRunId String
  productId     String
  warehouseId   String
  type          RecommendationType
  priority      Priority
  message       String
  quantity      Float?
  status        RecommendationStatus @default(OPEN)

  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  actedById      String?

  planningRun PlanningRun @relation(fields: [planningRunId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  actedBy     User?       @relation(fields: [actedById], references: [id])

  actionType     String?
  confidence     Float?
  expectedImpact String?
  impactValue    Float?
  signals        RecommendationSignal[]

  createdAt DateTime @default(now())

  @@index([status, priority])
  @@index([planningRunId, status])
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WarehouseTier {
  METRO
  TIER_1
  TIER_2
  TIER_3
}

enum PromotionType {
  PROMOTION
  SEASONAL
  HOLIDAY
  CAMPAIGN
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum SupplySource {
  EXISTING
  TRANSFER
  PLANNED_SUPPLY
}

enum PlanStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum RecommendationType {
  INCREASE_SUPPLY
  REDUCE_SUPPLY
  TRANSFER_STOCK
  STOCKOUT_RISK
  EXPIRY_RISK
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecommendationStatus {
  OPEN
  ACCEPTED
  REJECTED
  COMPLETED
}

/**
 * `sku`, `productName` and `location` are the display copy a detector wrote at the
 * moment it fired. `productId` and `warehouseId` are what identity is keyed on -
 * the fingerprint, every scoped filter, and every deep link. Renaming a warehouse
 * must not orphan an alert a planner already acknowledged.
 */
model Alert {
  id                String                 @id @default(cuid())
  severity          String
  type              String
  title             String
  sku               String?
  productName       String?
  location          String
  productId         String?
  warehouseId       String?
  detectedAt        DateTime
  businessImpact    String
  status            String
  recommendedAction String
  explanation       String
  notifiedAt        DateTime?
  metrics           AlertMetric[]
  timeline          AlertTimelineEvent[]
  deliveries        NotificationDelivery[]

  product   Product?   @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
  @@index([productId])
  @@index([status, severity])
}

/**
 * One row per channel per attempt, written whether or not the send succeeded.
 * `SKIPPED` is the load-bearing status: a channel the rules disabled and a channel
 * whose provider is not configured both record a row, so the settings page can show
 * why nothing arrived instead of showing an empty log.
 */
model NotificationDelivery {
  id        String  @id @default(cuid())
  alertId   String
  channel   String
  status    String
  recipient String?
  error     String?
  attempts  Int     @default(1)

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([alertId])
  @@index([channel, status])
  @@index([createdAt])
}

model SystemSettings {
  id String @id @default(cuid())

  general       GeneralSettings?
  forecast      ForecastSettings?
  inventory     InventorySettings?
  alerts        AlertSettings?
  notifications NotificationSettings?
  ai            AISettings?
  integrations  IntegrationSettings?
  security      SecuritySettings?

  updatedAt DateTime @updatedAt
}

/**
 * The movement ledger. Written by nothing yet - Phase 3.1 is its writer.
 *
 * `warehouseId` is the DC the row belongs to, which is what a DC page filters on.
 * It does not replace `fromLocation` / `toLocation`: a transfer has two endpoints
 * and one foreign key cannot hold both.
 */
model StockMovement {
  id           String   @id @default(cuid())
  date         DateTime
  movementType String
  sku          String
  quantity     Float
  warehouseId  String?
  fromLocation String?
  toLocation   String?
  reference    String?
  userOrSystem String?

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  @@index([warehouseId, date])
}

/**
 * Nullable because the existing rows predate the column and carry no warehouse to
 * recover one from - a network-wide record stays network-wide rather than being
 * assigned to an arbitrary DC.
 */
model WastePreventionRecord {
  id          String   @id @default(cuid())
  productName String
  actionTaken String
  unitsSaved  Float
  valueSaved  Float
  date        DateTime
  warehouseId String?

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  @@index([warehouseId])
}

// --- Replaced JSON fields with strict relations ---

model AlertMetric {
  id      String @id @default(cuid())
  alertId String
  label   String
  value   String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model AlertTimelineEvent {
  id          String   @id @default(cuid())
  alertId     String
  time        DateTime
  description String
  alert       Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model RecommendationSignal {
  id               String         @id @default(cuid())
  recommendationId String
  type             String
  label            String
  direction        String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}

model SimulationMetric {
  id             String   @id @default(cuid())
  scenarioId     String
  label          String
  currentValue   Float
  simulatedValue Float
  delta          Float
  unit           String
  direction      String
  format         String
  scenario       Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model ScenarioDCImpact {
  id                    String   @id @default(cuid())
  scenarioId            String
  name                  String
  currentCapacity       Float
  simulatedCapacity     Float
  currentStockoutRisk   Float
  simulatedStockoutRisk Float
  currentAtRiskValue    Float
  simulatedAtRiskValue  Float
  scenario              Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model ScenarioSKUImpact {
  id                 String   @id @default(cuid())
  scenarioId         String
  name               String
  sku                String
  currentInventory   Float
  simulatedInventory Float
  optimalInventory   Float
  scenario           Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model ScenarioRiskIndicator {
  id             String   @id @default(cuid())
  scenarioId     String
  name           String
  icon           String
  currentValue   Float
  simulatedValue Float
  delta          Float
  severity       String
  scenario       Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model GeneralSettings {
  id                 String         @id @default(cuid())
  systemSettingsId   String         @unique
  workspaceName      String
  organization       String
  region             String
  timezone           String
  dateFormat         String
  currency           String
  language           String
  theme              String
  density            String
  defaultLandingPage String
  systemSettings     SystemSettings @relation(fields: [systemSettingsId], references: [id], onDelete: Cascade)
}

model ForecastSettings {
  id                     String         @id @default(cuid())
  systemSettingsId       String         @unique
  defaultHorizon         Int
  defaultModel           String
  confidenceThreshold    Float
  updateFrequency        String
  predictionInterval     Float
  autoRefresh            Boolean
  targetAccuracy         Float
  alertAccuracyThreshold Float
  systemSettings         SystemSettings @relation(fields: [systemSettingsId], references: [id], onDelete: Cascade)
}

model InventorySettings {
  id                   String         @id @default(cuid())
  systemSettingsId     String         @unique
  defaultSafetyStock   Float
  reorderPoint         Float
  maxInventory         Float
  minServiceLevel      Float
  autoReorder          Boolean
  coverageWarning      Float
  coverageCritical     Float
  safetyStockWarning   Float
  safetyStockCritical  Float
  capacityWarning      Float
  capacityCritical     Float
  expiryWindowWarning  Float
  expiryWindowCritical Float
  systemSettings       SystemSettings @relation(fields: [systemSettingsId], references: [id], onDelete: Cascade)
}

model AlertSettings {
  id                       String         @id @default(cuid())
  systemSettingsId         String         @unique
  realTimeMonitoring       Boolean
  typeStockoutRisk         Boolean
  typeDemandSpike          Boolean
  typeExpiryRisk           Boolean
  typeSupplierDelay        Boolean
  typeCapacityBreach       Boolean
  typeForecastAnomaly      Boolean
  typeOverstock            Boolean
  thresholdStockoutProb    Float
  thresholdDemandDeviation Float
  thresholdExpiryWindow    Float
  thresholdCapacityUtil    Float
  thresholdSupplierDelay   Float
  escalationCritical       String
  escalationHigh           String
  escalationMedium         String
  escalationLow            String
  systemSettings           SystemSettings @relation(fields: [systemSettingsId], references: [id], onDelete: Cascade)
}

model NotificationSettings {
  id                 String             @id @default(cuid())
  systemSettingsId   String             @unique
  channelInApp       Boolean
  channelEmail       Boolean
  channelSms         Boolean
  channelTeams       Boolean
  dailyDigestEnabled Boolean
  dailyDigestTime    String
  systemSettings     SystemSettings     @relation(fields: [systemSettingsId], references: [id], onDelete: Cascade)
  rules              NotificationRule[]
}

model NotificationRule {
  id                     String               @id @default(cuid())
  notificationSettingsId String
  event                  String
  inApp                  Boolean
  email                  Boolean
  sms                    Boolean
  notificationSettings   NotificationSettings @relation(fields: [notificationSettingsId], references: [id], onDelete: Cascade)
}

model AISettings {
  id                       String         @id @default(cuid())
  systemSettingsId         String         @unique
  primaryModel             String
  modelConfidence          Float
  recommendationConfidence Float
  featRecommendations      Boolean
  featExplainability       Boolean
  featAutoRiskDetection    Boolean
  factorDemandForecast     Float
  factorInventoryPosition  Float
  factorLeadTime           Float
  factorExpiryRisk         Float
  factorNetworkCapacity    Float
  systemSettings           SystemSettings @relation(fields: [systemSettingsId], references: [id], onDelete: Cascade)
}

model IntegrationSettings {
  id               String              @id @default(cuid())
  systemSettingsId String              @unique
  autoSync         Boolean
  syncFrequency    String
  apiStatus        String
  apiEnvironment   String
  apiVersion       String
  systemSettings   SystemSettings      @relation(fields: [systemSettingsId], references: [id], onDelete: Cascade)
  sources          IntegrationSource[]
}

model IntegrationSource {
  id                    String              @id @default(cuid())
  integrationSettingsId String
  sourceId              String
  name                  String
  status                String
  lastSync              String
  records               Int
  integrationSettings   IntegrationSettings @relation(fields: [integrationSettingsId], references: [id], onDelete: Cascade)
}

model SecuritySettings {
  id               String         @id @default(cuid())
  systemSettingsId String         @unique
  twoFactor        Boolean
  sessionTimeout   Int
  passwordPolicy   String
  loginAlerts      Boolean
  auditLogging     Boolean
  systemSettings   SystemSettings @relation(fields: [systemSettingsId], references: [id], onDelete: Cascade)
}
