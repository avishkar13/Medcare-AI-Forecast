NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
SHUTDOWN_TIMEOUT_MS=10000

DATABASE_URL=postgresql://user:password@localhost:5432/cognizant

# Omit in development to fall back to an in-process limiter store.
# Required when NODE_ENV=production.
REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

BODY_LIMIT=1mb

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREFIX=rl
RATE_LIMIT_IPV6_SUBNET=56
RATE_LIMIT_ALLOWLIST=
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_EXPENSIVE_WINDOW_MS=3600000
RATE_LIMIT_EXPENSIVE_MAX=10
