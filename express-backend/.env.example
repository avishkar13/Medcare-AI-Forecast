NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT=1mb

DATABASE_URL=postgresql://cognizant:cognizant_secret@localhost:5432/cognizant

JWT_SECRET=super_secret_jwt_key_for_development_purposes_only@54455454fsfdsff
JWT_EXPIRES_IN=7d

# Required when NODE_ENV=production, so rate limits are shared across instances.
REDIS_URL=redis://:cognizant_redis@localhost:6379

CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREFIX=rl
RATE_LIMIT_IPV6_SUBNET=56
RATE_LIMIT_ALLOWLIST=
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_READ_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_WRITE_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_EXPENSIVE_WINDOW_MS=3600000
RATE_LIMIT_EXPENSIVE_MAX=10

# A run older than the timeout is treated as abandoned and no longer blocks a new one.
PLANNING_RUN_TIMEOUT_MS=900000
# How long an Idempotency-Key is remembered. Requires REDIS_URL; ignored without it.
PLANNING_IDEMPOTENCY_TTL_MS=86400000
# "disabled" accepts runs but never executes them, which is what the test suite wants.
PLANNING_EXECUTOR=inline
PLANNING_SIMULATION_ITERATIONS=500
# How many COMPLETED runs keep their plan artefacts (InventoryPlan, SupplyPlan,
# DRPPlan, Recommendation). Forecasts and cost roll-ups are never pruned. 0 disables.
PLANNING_RETENTION_RUNS=20

# Empty means no Python forecasting service; the naive seasonal fallback is used instead.
FORECAST_SERVICE_URL=
FORECAST_TIMEOUT_MS=60000
# Retries apply to network errors, 5xx and 429 only - never to a 4xx.
FORECAST_RETRIES=2
# false makes a forecast failure fail the run instead of falling back.
FORECAST_FALLBACK=true
# Fitting is minutes, not seconds, so it gets its own budget.
FORECAST_TRAIN_TIMEOUT_MS=600000

# How often the whole alert table is reconciled against current conditions. Detection
# also runs at the end of a planning run and on POST /api/alerts/refresh; this is what
# keeps alerts current when nobody is doing either. 0 disables the scheduler.
ALERT_DETECTION_INTERVAL_MS=300000

# Notification delivery. Every credential below is optional: an unconfigured channel
# records SKIPPED against the alert with a reason rather than failing detection, so a
# deploy with no mail account still detects and still fills the bell.

# Resend. EMAIL_FROM must be on a domain verified with them or sends come back 403.
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated. No recipients means email is treated as unconfigured.
ALERT_EMAIL_RECIPIENTS=

# AWS SNS. Set a topic ARN and SNS fans out to its subscribers; otherwise each
# number in ALERT_SMS_RECIPIENTS is published to individually (E.164, comma-separated).
# Indian destinations need the sender ID and template registered under TRAI DLT before
# delivery succeeds; until that clears sends land as FAILED in the log.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_TOPIC_ARN=
AWS_SNS_SENDER_ID=
ALERT_SMS_RECIPIENTS=

# Microsoft Teams incoming webhook. The URL is the whole credential, so treat it as
# a secret. Unset means the Teams channel records SKIPPED like any other.
TEAMS_WEBHOOK_URL=

# Floor for the channels that interrupt someone. In-app ignores this and carries
# every severity, because the bell is the review surface.
NOTIFY_MIN_SEVERITY=high
NOTIFY_TIMEOUT_MS=10000

# Read by docker-compose.yml and docker-entrypoint.sh, not by the app.
POSTGRES_USER=cognizant
POSTGRES_PASSWORD=cognizant_secret
POSTGRES_DB=cognizant
REDIS_PASSWORD=cognizant_redis
RUN_SEED=true
